CAMERA_SOURCES=0
TARGET_FPS=30
POSE_MODEL_PATH=models/yolo11s-pose-480x640.onnx
INFERENCE_PROVIDER=directml
FACILITY_ID=fac-poc-001
BUILDING_ID=bld-poc-001
QUEUE_DB_PATH=data/queue.sqlite3
REGISTRY_DB_PATH=data/camera_registry.sqlite3
MOCK_BACKEND_URL=http://localhost:8000

# Supabase project/runtime config. Real values belong in .env only.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Server-only Supabase secrets. Never expose these in browser/mobile code.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MERIDIAN_SUPABASE_SERVICE_ROLE_KEY=

# Emergency SMS escalation (server-side Edge Function secrets only). The
# callback URL must be the deployed notify-family URL with ?twilio_status=1.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MERIDIAN_SMS_STATUS_CALLBACK_URL=

# Facility-controlled Hub encryption. Real key belongs in .env only.
VISITOR_EMBEDDING_ENCRYPTION_KEY=
VISITOR_EMBEDDING_KEY_ID=

# Server-side vision description for unknown visitors. Never expose these
# keys in browser/mobile code.
# Primary: real Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=45

# Fallback: Hack Club AI proxy (optional).
HACKCLUB_AI_API_KEY=
HACKCLUB_AI_BASE_URL=https://ai.hackclub.com/proxy/v1
HACKCLUB_AI_VISION_MODEL=google/gemini-2.5-flash
HACKCLUB_AI_TIMEOUT_SECONDS=45
