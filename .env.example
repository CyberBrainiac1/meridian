SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MERIDIAN_SUPABASE_SERVICE_ROLE_KEY=

# Facility-controlled Hub encryption. Real key belongs in .env only.
VISITOR_EMBEDDING_ENCRYPTION_KEY=
VISITOR_EMBEDDING_KEY_ID=
