SUPABASE_URL=https://your-project-ref.supabase.co

# Prefer Supabase's managed function secrets in deployed environments. Keep this
# file as documentation only; never commit a real service-role or secret key.
MERIDIAN_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key
SUPABASE_SECRET_KEY=replace-with-secret-key
SUPABASE_SECRET_KEYS=replace-with-secret-keys-json

# Shared secret for internal-only functions (e.g. notify-family) that are
# triggered by a scheduler/ops call, not an end-user session.
MERIDIAN_INTERNAL_FUNCTION_SECRET=replace-with-a-random-32-byte-hex-value
